# Copia este archivo como ".env" (en la misma carpeta que docker-compose.yml) y completa los valores.
# El archivo .env NO se sube a Git (agrégalo al .gitignore): contiene credenciales.

# URL desde donde se abre el sistema (se usa para armar el enlace del correo)
FRONTEND_ORIGIN=http://localhost:5173

# --- Gmail con "Contraseña de aplicación" ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo_del_sistema@gmail.com
# 16 letras que genera Google (sin espacios). NO es la contraseña normal de la cuenta.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=Stock Oferta de los Álamos <tu_correo_del_sistema@gmail.com>
